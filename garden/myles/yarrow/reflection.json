{
  "lexicon": 1,
  "id": "garden.myles.yarrow.reflection",
  "defs": {
    "main": {
      "type": "record",
      "description": "The querent's own note on a reading. Separate from the reading because someone else may have written it.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["reading", "text", "createdAt"],
        "properties": {
          "reading": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "maxGraphemes": 3000
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
