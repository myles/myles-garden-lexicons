{
  "lexicon": 1,
  "id": "garden.myles.yarrow.reading",
  "defs": {
    "main": {
      "type": "record",
      "description": "A pulled spread, kept as a snapshot. Stored in a space: a private one for your own readings, or one shared with the querent when reading for someone else.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["spread", "deck", "cards", "createdAt"],
        "properties": {
          "querent": {
            "type": "string",
            "format": "did",
            "description": "Who the reading is for. Omit when the author read for themselves."
          },
          "spread": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The exact spread version used."
          },
          "deck": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The exact deck version used."
          },
          "interpretationSet": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The exact interpretation set version used, if any."
          },
          "cards": {
            "type": "array",
            "minLength": 1,
            "maxLength": 78,
            "items": { "type": "ref", "ref": "#drawnCard" }
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "maxGraphemes": 3000,
            "description": "The written reading."
          },
          "textAuthor": {
            "type": "string",
            "description": "Who wrote the text: the reading's author, or a model.",
            "knownValues": ["reader", "model"]
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "drawnCard": {
      "type": "object",
      "required": ["position", "cardId", "orientation"],
      "properties": {
        "position": {
          "type": "string",
          "maxLength": 64,
          "description": "A position id from the spread."
        },
        "cardId": { "type": "ref", "ref": "garden.myles.yarrow.defs#cardId" },
        "orientation": {
          "type": "string",
          "knownValues": ["upright", "reversed"]
        }
      }
    }
  }
}
