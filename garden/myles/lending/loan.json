{
  "lexicon": 1,
  "id": "garden.myles.lending.loan",
  "defs": {
    "main": {
      "type": "record",
      "description": "An approved loan of an item. Written to the lender's repo.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["item", "borrower", "status", "createdAt"],
        "properties": {
          "item": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the garden.myles.lending.item being lent."
          },
          "borrower": {
            "type": "string",
            "format": "did",
            "description": "DID of the person borrowing the item."
          },
          "request": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The garden.myles.lending.request this loan answers, if any."
          },
          "status": {
            "type": "ref",
            "ref": "garden.myles.lending.defs#loanStatus"
          },
          "lentAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the item was handed over."
          },
          "dueAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the item should come back."
          },
          "returnedAt": {
            "type": "string",
            "format": "datetime"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the loan last changed, e.g. its status."
          }
        }
      }
    }
  }
}
